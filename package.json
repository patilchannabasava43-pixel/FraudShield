{
  "name": "fraudshield-ai",
  "private": true,
  "version": "2.0.0",
  "description": "FraudShield AI \u2014 synthetic financial fraud risk demonstration, Supabase workspace and optional Express API",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node --test tests/*.test.mjs backend/test/validators.test.mjs",
    "check": "npm run test && npm run test:api && npm run build",
    "test:api": "node --test backend/test/api.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "fraud-detection",
    "react",
    "supabase",
    "express",
    "financial-security",
    "academic-project"
  ],
  "type": "module"
}