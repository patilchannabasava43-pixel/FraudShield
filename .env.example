# FraudShield AI has the dedicated Supabase project's public configuration
# preconfigured in src/lib/supabase.js. No .env file is required to run locally.
# You can optionally override these values with another Supabase project.
# NEVER use a secret or service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
